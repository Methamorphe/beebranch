# Copier vers .env puis renseigner : les builds de release locaux
# (`npm run release:build`) lisent ce fichier. .env est ignoré par git.
# Les valeurs sont entre guillemets : le fichier est chargé par `source` en bash.

# --- Signature macOS -------------------------------------------------------
# Identité exacte : security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: <Nom> (<TEAMID>)"

# --- Notarisation macOS (clé API App Store Connect, Team Keys) -------------
# Key ID (10 caractères), Issuer ID (UUID) et chemin du fichier .p8.
APPLE_API_KEY="<KEYID>"
APPLE_API_ISSUER="<ISSUER-UUID>"
APPLE_API_KEY_PATH="$HOME/Documents/AuthKey_<KEYID>.p8"

# --- Signature minisign de l'updater --------------------------------------
TAURI_SIGNING_PRIVATE_KEY_FILE="src-tauri/keys/release.key"
TAURI_SIGNING_PRIVATE_KEY_PASSWORD_FILE="src-tauri/keys/release.key.password"

# --- Endpoint injecté à la compilation ------------------------------------
BEEBRANCH_UPDATE_ENDPOINT="https://github.com/Methamorphe/beebranch/releases/latest/download/latest.json"
